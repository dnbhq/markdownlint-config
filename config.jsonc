{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.22.1/schema/markdownlint-cli2-config-schema.json",
  "$id": "https://raw.githubusercontent.com/dnbhq/markdownlint-config/refs/heads/main/config.jsonc",
  "customRules": [
    "./rules/markdownlint-github.cjs",
    "./rules/relative-links.cjs",
    "./rules/search-replace.cjs",
    "./rules/extended-ascii.cjs",
    "./rules/title-case-style.cjs",
    "./rules/list-duplicates.cjs"
  ],
  "config": {
    "extends": "./rules.jsonc"
  }
}
