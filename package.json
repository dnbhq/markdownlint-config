{
  "name": "@dnbhq/markdownlint-config",
  "description": "Shared markdownlint configuration for DNBHQ projects.",
  "version": "0.2.10",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnbhq/markdownlint-config.git"
  },
  "author": "Patrick Kollitsch <davidsneighbourdev+gh@gmail.com> (https://davids-neighbour.com)",
  "bugs": "https://github.com/dnbhq/markdownlint-config/issues",
  "homepage": "https://github.com/dnbhq/markdownlint-config#readme",
  "dependencies": {
    "@github/markdownlint-github": "0.8.3",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.1",
    "markdownlint-rule-extended-ascii": "0.2.1",
    "markdownlint-rule-relative-links": "5.1.1",
    "markdownlint-rule-search-replace": "1.2.0",
    "markdownlint-rule-title-case-style": "0.4.3"
  },
  "devDependencies": {
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/node": "26.1.1",
    "lint-staged": "17.0.8",
    "release-it": "20.2.1",
    "simple-git-hooks": "2.13.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "lint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc README.md",
    "lint:staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "release": "release-it --ci",
    "release:dry": "release-it --dry-run",
    "test": "npm run lint"
  },
  "main": ".markdownlint-cli2.jsonc",
  "files": [
    ".markdownlint-cli2.jsonc",
    "rules/*.cjs",
    ".markdownlintignore",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "4.3.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./.markdownlint-cli2.jsonc",
    "./config": "./.markdownlint-cli2.jsonc",
    "./.markdownlint-cli2.jsonc": "./.markdownlint-cli2.jsonc",
    "./ignore": "./.markdownlintignore",
    "./.markdownlintignore": "./.markdownlintignore"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "markdownlint-cli2 --config .markdownlint-cli2.jsonc --fix --no-globs"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --allow-empty"
  },
  "type": "module"
}
